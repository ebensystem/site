rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function admin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function validClient() {
      let d = request.resource.data;
      return d.keys().hasAll(['empresa', 'contato', 'gerente', 'plano', 'valorProjeto', 'valorMensal', 'pago', 'ativo', 'createdAt', 'createdBy'])
        && d.keys().hasOnly(['empresa', 'contato', 'gerente', 'plano', 'valorProjeto', 'valorMensal', 'pago', 'ativo', 'createdAt', 'createdBy'])
        && d.empresa is string && d.empresa.size() > 0 && d.empresa.size() <= 200
        && d.contato is string && d.contato.size() > 0 && d.contato.size() <= 200
        && d.gerente is string && d.gerente.size() > 0 && d.gerente.size() <= 200
        && d.plano in ['Essencial', 'Profissional', 'Personalizado', 'Business', 'Start', 'Sob Medida']
        && d.valorProjeto is number && d.valorProjeto >= 0 && d.valorProjeto <= 1000000000
        && d.valorMensal is number && d.valorMensal >= 0 && d.valorMensal <= 1000000000
        && d.pago is bool && d.ativo is bool;
    }
    match /clientes/{clientId} {
      allow read, delete: if admin();
      allow create: if admin() && validClient()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if admin() && validClient()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;
    }
    // O usuário consulta somente seu documento. Papéis são geridos pelo Console/IAM.
    match /users/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
    // Todas as demais coleções permanecem fechadas.
    match /{document=**} { allow read, write: if false; }
  }
}
