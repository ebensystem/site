rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function admin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function text(value, max) { return value is string && value.size() <= max; }
    function amount(value) { return value is number && value >= 0 && value <= 1000000000; }
    function date(value) {
      return value is string && value.matches('20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])');
    }
    function validClient() {
      let d = request.resource.data;
      return d.keys().hasAll(['empresa','contato','gerente','plano','valorProjeto','valorMensal','pago','ativo','createdAt','createdBy'])
        && d.keys().hasOnly(['empresa','contato','gerente','plano','valorProjeto','valorMensal','pago','ativo','createdAt','createdBy','email','telefone','documento','servico','inicioContrato','ciclo','diaVencimento','formaPagamento','observacoes','schemaVersion','updatedAt','updatedBy'])
        && text(d.empresa,200) && d.empresa.size() > 0
        && text(d.contato,200) && d.contato.size() > 0
        && text(d.gerente,200) && d.gerente.size() > 0
        && text(d.plano,120) && d.plano.size() > 0
        && amount(d.valorProjeto) && amount(d.valorMensal)
        && d.pago is bool && d.ativo is bool
        && text(d.get('email',''),200) && text(d.get('telefone',''),40)
        && text(d.get('documento',''),30) && text(d.get('observacoes',''),2000)
        && d.get('servico','Outro') in ['Site','Aplicativo','Sistema','Infraestrutura','Outro']
        && d.get('ciclo','mensal') in ['mensal','unico']
        && d.get('diaVencimento',10) is int && d.get('diaVencimento',10) >= 1 && d.get('diaVencimento',10) <= 31
        && d.get('formaPagamento','Pix') in ['Pix','Boleto','Transferência','Cartão','Outro']
        && d.get('schemaVersion',1) in [1,2]
        && (d.get('schemaVersion',1) == 1 || (
          d.keys().hasAll(['email','telefone','documento','servico','inicioContrato','ciclo','diaVencimento','formaPagamento','observacoes','updatedAt','updatedBy'])
          && date(d.inicioContrato)
          && (d.ciclo != 'unico' || d.valorMensal == 0)
          && d.updatedAt == request.time && d.updatedBy == request.auth.uid
        ));
    }
    match /clientes/{clientId} {
      allow read: if admin();
      allow create: if admin() && validClient()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if admin() && validClient()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;
      // Inativação preserva contratos e histórico financeiro.
      allow delete: if false;
    }
    function validBill() {
      let d = request.resource.data;
      return d.keys().hasAll(['clienteId','descricao','valorCentavos','vencimento','competencia','tipo','status','paidDate','createdAt','createdBy','updatedAt','updatedBy'])
        && d.keys().hasOnly(['clienteId','descricao','valorCentavos','vencimento','competencia','tipo','status','paidDate','createdAt','createdBy','updatedAt','updatedBy'])
        && text(d.clienteId,128) && d.clienteId.size() > 0
        && text(d.descricao,200) && d.descricao.size() > 0
        && d.valorCentavos is int && d.valorCentavos > 0 && d.valorCentavos <= 100000000000
        && date(d.vencimento)
        && d.competencia is string && d.competencia.matches('20[0-9]{2}-(0[1-9]|1[0-2])')
        && d.tipo in ['mensalidade','avulsa']
        && d.status in ['open','paid','cancelled']
        && ((d.status == 'paid' && date(d.paidDate)) || (d.status != 'paid' && d.paidDate == ''))
        && d.updatedAt == request.time && d.updatedBy == request.auth.uid;
    }
    match /cobrancas/{billId} {
      allow read: if admin();
      allow create: if admin() && validBill()
        && exists(/databases/$(database)/documents/clientes/$(request.resource.data.clienteId))
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && (request.resource.data.tipo == 'avulsa'
          || billId == request.resource.data.clienteId + '_' + request.resource.data.competencia);
      allow update: if admin() && validBill()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','paidDate','updatedAt','updatedBy'])
        && ((resource.data.status == 'open' && request.resource.data.status in ['paid','cancelled'])
          || (resource.data.status in ['paid','cancelled'] && request.resource.data.status == 'open'));
      allow delete: if false;
    }
    match /users/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}